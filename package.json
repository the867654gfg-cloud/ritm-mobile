{
  "name": "ritm-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:zip": "npx expo export --platform web --clear && powershell -Command \"Set-Location dist; Compress-Archive -Path * -DestinationPath ..\\dist.zip -Force; Set-Location ..\""
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.7",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.14",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "gh-pages": "^6.3.0",
    "typescript": "^5.1.3"
  },
  "private": true
}
